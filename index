<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>For My Favorite Person ❤️</title>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #ffe6eb;
      color: #590d22;
      min-height: 100vh;
    }

    /* --- PIN GATE OVERLAY --- */
    #pin-screen {
      position: fixed;
      inset: 0;
      background: #ffe6eb;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 20px;
    }
    .pin-card {
      background: white;
      padding: 2.5rem;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(255, 77, 109, 0.2);
      text-align: center;
      max-width: 350px;
      width: 100%;
    }
    .pin-input {
      width: 100%;
      letter-spacing: 15px;
      font-size: 2rem;
      text-align: center;
      padding: 10px;
      margin: 20px 0 10px 0;
      border: 2px solid #ffb3c1;
      border-radius: 12px;
      outline: none;
      color: #590d22;
    }
    .error-msg {
      color: #c9184a;
      font-weight: 600;
      font-size: 0.9rem;
      min-height: 24px;
      margin-top: 5px;
    }

    /* --- MAIN CONTENT & CENTERING --- */
    #main-content {
      display: none;
      width: 100%;
      min-height: 100vh;
      position: relative;
      padding: 60px 20px;
    }

    .bg-collage {
      position: fixed;
      inset: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 12px;
      padding: 12px;
      z-index: 1;
      overflow: hidden;
      opacity: 0.45;
    }
    .bg-collage img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      border: 4px solid #ffb3c1;
      border-radius: 14px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    /* Centered Container */
    .content-container {
      position: relative;
      z-index: 10;
      max-width: 500px;
      width: 100%;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: calc(100vh - 120px);
      gap: 25px;
    }

    .card {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(8px);
      padding: 2rem;
      border-radius: 20px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      border: 2px solid #ffccd5;
      text-align: center;
      width: 100%;
    }

    /* --- ENVELOPE / LOVE LETTER --- */
    .envelope-wrapper {
      cursor: pointer;
      background: #ffb3c1;
      border-radius: 15px;
      padding: 20px;
      transition: transform 0.2s;
    }
    .envelope-wrapper:hover {
      transform: scale(1.02);
    }
    .letter-paper {
      display: none;
      background: #fff;
      padding: 20px;
      border-radius: 10px;
      border: 1px dashed #ff4d6d;
      margin-top: 15px;
      text-align: left;
      line-height: 1.6;
      font-size: 0.95rem;
    }

    /* --- BUTTONS & PLAYER --- */
    button {
      background-color: #ff4d6d;
      color: white;
      border: none;
      padding: 12px 24px;
      font-size: 1rem;
      border-radius: 25px;
      cursor: pointer;
      margin-top: 15px;
      transition: transform 0.2s, background-color 0.2s;
    }
    button:hover {
      transform: scale(1.05);
      background-color: #c9184a;
    }
    iframe {
      border-radius: 12px;
      width: 100%;
      height: 152px;
      border: none;
    }
  </style>
</head>
<body>

