  <script>
    // Set your 4-digit PIN here
    const CORRECT_PIN = "1209";

    function checkPin() {
      const input = document.getElementById('pin');
      const errorDiv = document.getElementById('error-message');

      if (input.value.length === 4) {
        if (input.value === CORRECT_PIN) {
          document.getElementById('pin-screen').style.display = 'none';
          document.getElementById('main-content').style.display = 'block';
        } else {
          errorDiv.innerText = "you dont know our special day? 😢";
          input.value = "";
        }
      } else {
        errorDiv.innerText = "";
      }
    }

    function toggleLetter() {
      const letter = document.getElementById('letter');
      letter.style.display = letter.style.display === 'block' ? 'none' : 'block';
    }

    const notes = [
      "1. Your laugh is my absolute favorite sound in the world.",
      "2. How caring you are toward everyone around you.",
      "3. The way you make even ordinary days feel special.",
      "4. Your amazing and corny sense of humor.",
      "5. How safe and happy I feel whenever I'm holding your hand.",
      "6. How I feel warmth just being close to you.",
      "7. How you make me smile.",
      "8. Your cute unintentional bumbum dance when you cook.",
      "9. When you share your unimaginable dreams with me.",
      "10. How you outsmart me on simple things (I just don't admit it)",
      "11. When you sing to me.",
      "12. The way that you're so down-to-earth (also an angel in my eyes).",
      "13. Your mischieful personality.(haha pervy)",
      "14. How thoughtful you are.",
      "15. How tightly you hug me when you missed me so much",
      "16. How you bid me goodmornings with tender kissies.(my favorite ^^)",
      "17. How you make me feel the most luckiest person on earth who ever lived.",
      "18. Your loving and patient nature.",
      "19. Simply being YOU!"
    ];

    let currentNoteIndex = 0;

    function newNote() {
      document.getElementById('love-note').innerText = notes[currentNoteIndex];
      currentNoteIndex = (currentNoteIndex + 1) % notes.length;
    }
  </script>

